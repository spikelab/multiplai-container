#!/usr/bin/env bash
# check-hookspath — warn where the container-wide git hook gate does not reach.
#
# The container gates every repo through the SYSTEM-level core.hooksPath
# (/etc/gitconfig → git-hooks/dispatch). Two ways a repo slips out from under
# it, both silent, both detectable only from outside git:
#
#   1. A repo-local `core.hooksPath` — what husky/lefthook-style installs
#      write — outranks system config and un-gates that repo entirely. That
#      precedence fight cannot be won from /etc/gitconfig.
#   2. `core.hooksPath` REPLACES .git/hooks rather than adding to it, so a
#      repo-local hook whose name the dispatcher does not symlink is disabled
#      outright. The dispatcher chains every name it does symlink; the ones
#      deliberately left out of the Dockerfile's loop (reference-transaction,
#      pre-auto-gc, post-index-change) are exactly the gap here.
#
# Both are compensating controls: scan the workspace, name what is not covered,
# and let a human decide. It is a WARNING, never a blocker — local hooksPath
# has legitimate uses (this repo's own test harness, for one), and blocking
# container start over it would be a denial-of-service on the workspace.
#
# Usage: check-hookspath [ROOT]     (default ROOT: $WORKSPACE)
#
# Always exits 0. Output goes to stderr, only when something is found — a
# finding, or a one-line note when the depth bound cut the walk short.
#
# Scope: working checkouts only (`.git` directories and worktree/submodule
# `.git` files). Bare repos (`*.git`) are not scanned — nothing commits from
# inside a bare repo, and the receive-side hooks it runs resolve through the
# same system hooksPath. Depth-bounded and pruned (dependency dirs, and `.git`
# itself once matched) so a large bind-mounted workspace stays cheap to scan at
# container start.
set -uo pipefail

root="${1:-${WORKSPACE:-}}"
{ [ -n "$root" ] && [ -d "$root" ]; } || exit 0
# The depth arithmetic below counts path components, so the root must not
# carry a trailing slash.
[ "$root" = / ] || root="${root%/}"

# The hook names this gate covers are exactly the dispatcher symlinks sitting
# next to this script. Deriving the set instead of restating it means the
# Dockerfile's symlink loop cannot drift out of sync with this check. When the
# set cannot be determined — running from a source checkout, where the symlinks
# only exist in the built image — check 2 is skipped rather than guessed at.
covered=""
self_dir="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || self_dir=""
if [ -n "$self_dir" ] && [ -e "$self_dir/dispatch" ]; then
    for link in "$self_dir"/*; do
        [ -L "$link" ] || continue
        [ "$(readlink "$link")" = dispatch ] || continue
        covered="$covered ${link##*/}"
    done
fi

hookspath_hits=()
orphan_hits=()
seen_hookdirs=" "
truncated=""
base_fields=$(printf '%s' "$root" | awk -F/ '{ print NF }')

# ONE walk of the workspace answers both questions: which repos exist within
# the depth bound, and did the bound cut the scan short. This runs at every
# container start on a bind-mounted workspace, where directory traversal is
# the dominant cost — a second find for the truncation probe would double it.
#
# The -maxdepth 7 repo bound is a deliberate cost ceiling, but a scan it cut
# short must say so — a clean report that is silently incomplete is exactly
# the kind of quiet gap this script exists to remove. "Cut short" means
# unseen territory exists: some directory (or worktree/submodule `.git` file)
# at depth 8 that the repo scan never reached. So find walks one level past
# the bound with `-type d` emitted too, and awk classifies each line by
# depth: anything at depth ≥ 8 (relative to the root) means truncation,
# `.git` hits above the bound feed the repo loop below via a sentinel-free
# print, and the sentinel line at the end carries the truncation verdict.
# `.git` is printed-then-pruned so a repo just past the bound counts as
# unseen without find ever descending into any `.git` (whose objects/
# fan-out is what the ceiling protects against).
# NOTE: `-mindepth` is unusable here — GNU find treats it as a global option
# that would suppress -prune at shallow depths — hence the awk depth filter.
while IFS= read -r gitpath; do
    if [ "$gitpath" = "__depth-truncated__" ]; then
        truncated=y
        continue
    fi
    repo="${gitpath%/.git}"

    # 1. Local core.hooksPath override. For a worktree/submodule `.git` FILE,
    #    --local resolves to the shared repository config, which is exactly the
    #    file that would carry the override. `git config` exits 1 when unset.
    hp="$(git -C "$repo" config --local --get core.hooksPath 2>/dev/null)"
    if [ -n "$hp" ]; then
        hookspath_hits+=("  $repo  (core.hooksPath = $hp)")
        # An override un-gates the repo wholesale; its own hooks all still run,
        # so there is nothing to report under check 2 for it.
        continue
    fi

    # 2. Repo-local hooks the dispatcher does not chain. Resolve the hooks
    #    directory via --git-common-dir, NOT `--git-path hooks`: the latter
    #    honours core.hooksPath and would hand back the dispatcher's own
    #    directory. --git-common-dir also points every linked worktree at the
    #    single shared hooks directory, which is the one git actually uses.
    #    Same resolver as the dispatcher's own_hook lookup — keep the two in
    #    lockstep, or this check reports coverage the dispatcher does not
    #    deliver.
    [ -n "$covered" ] || continue
    common="$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || continue
    [ -n "$common" ] || continue
    case "$seen_hookdirs" in *" $common "*) continue;; esac
    seen_hookdirs="$seen_hookdirs$common "

    orphans=""
    for hook in "$common"/hooks/*; do
        # Explicit negation rather than `A && B || continue`, which shellcheck
        # rightly flags (SC2015) as not being if-then-else.
        if [ ! -f "$hook" ] || [ ! -x "$hook" ]; then continue; fi
        name="${hook##*/}"
        case "$name" in *.sample) continue;; esac
        case " $covered " in *" $name "*) continue;; esac
        orphans="$orphans $name"
    done
    [ -n "$orphans" ] && orphan_hits+=("  $repo  (${orphans# })")
done < <(find "$root" -maxdepth 8 \
            \( -name node_modules -o -name .venv -o -name venv \) -prune \
            -o -name .git -print -prune \
            -o -type d -print 2>/dev/null \
        | awk -F/ -v b="$base_fields" '
            NF >= b + 8   { deep = 1; next }
            /\/\.git$/    { print }
            END           { if (deep) print "__depth-truncated__" }')

if [ "${#hookspath_hits[@]}" -gt 0 ]; then
    printf '%s\n' \
        "secret-scan: WARNING — repos below set a repo-local core.hooksPath." \
        "  Local config outranks the container-wide gitleaks gate, so commits" \
        "  and pushes in these repos are NOT scanned for secrets:" >&2
    printf '%s\n' "${hookspath_hits[@]}" >&2
    printf '%s\n' \
        "  To restore the gate for a repo (its own .git/hooks still run — the" \
        "  dispatcher chains to them):" \
        "    git -C <repo> config --unset core.hooksPath" >&2
fi

if [ "${#orphan_hits[@]}" -gt 0 ]; then
    printf '%s\n' \
        "secret-scan: WARNING — repo-local hooks below are NOT running." \
        "  core.hooksPath replaces .git/hooks, and the dispatcher only chains" \
        "  hook names it symlinks. These names are not among them:" >&2
    printf '%s\n' "${orphan_hits[@]}" >&2
    printf '%s\n' \
        "  Fix by adding the name to the symlink loop in the container's" \
        "  Dockerfile, then cutting a release." >&2
fi

# Truncation verdict from the single walk above.
if [ -n "$truncated" ]; then
    printf '%s\n' \
        "secret-scan: note — hookspath scan is depth-bounded; entries deeper than 7 levels under $root were not checked." >&2
fi

exit 0
